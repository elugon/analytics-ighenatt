{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flarelytics-studio",
  "compatibility_date": "2026-03-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "main": "@astrojs/cloudflare/entrypoints/server",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "analytics": {
    "binding": "ANALYTICS_SQL"
  },
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "bb491ed78371400095a489cec75eb481"
    }
  ],
  "vars": {
    "OWNER_EMAILS": "elugon10@gmail.com",
    "ACCESS_TEAM_DOMAIN": "ighenatt.cloudflareaccess.com",
    "ACCESS_AUD": "6e9b8e6d38d11cc344e9689aff573d3e524da4ad5b01ee263104245ce217a9fe"
  }
}
