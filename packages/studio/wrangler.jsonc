{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flarelytics-studio",
  "compatibility_date": "2026-03-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [
    {
      "pattern": "analytics.ighenatt.es",
      "custom_domain": true,
    },
  ],
  "observability": {
    "enabled": true,
  },
  "main": "@astrojs/cloudflare/entrypoints/server",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
  },
  "analytics": {
    "binding": "ANALYTICS_SQL",
    "remote": true,
  },
  "d1_databases": [
    {
      "binding": "MEASUREMENT",
      "database_name": "flarelytics-measurement",
      "database_id": "ef5cf544-fe38-4f90-b052-a2bef0f8105c",
      "migrations_dir": "../measurement/migrations",
      "remote": true,
    },
  ],
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "bb491ed78371400095a489cec75eb481",
    },
  ],
  "vars": {
    "OWNER_EMAILS": "elugon10@gmail.com,elu.gonzalez@ighenatt.es,denys.dudyk@ighenatt.es",
    "ACCESS_TEAM_DOMAIN": "ighenatt.cloudflareaccess.com",
    "ACCESS_AUD": "6e9b8e6d38d11cc344e9689aff573d3e524da4ad5b01ee263104245ce217a9fe",
  },
}
